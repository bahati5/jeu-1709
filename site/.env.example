# ---------------------------------------------------------------
#  LE FONDS 47 — variables d'environnement
# ---------------------------------------------------------------

# --- Les deux liens ---
# Lui : https://…/api/entrer?t=$JOUEUR_TOKEN
# Toi : https://…/api/entrer?t=$ADMIN_TOKEN&vers=admin
JOUEUR_TOKEN=
ADMIN_TOKEN=

# --- Supabase ---
# La service_role traverse RLS : elle ne doit JAMAIS être préfixée NEXT_PUBLIC_.
# Sans ces deux variables, tout est écrit dans .data/fonds47.json — ce qui
# est parfait en local et INUTILISABLE sur Vercel (fichiers éphémères).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=fonds47

# --- Pour répéter ---
# Fige l'horloge du serveur. Ignoré quand NODE_ENV=production :
# la simulation ne peut pas servir à tricher en ligne.
# SIM_DATE=2026-09-17T06:30:00+01:00

# Facultatif — sert uniquement à `npm run supabase` pour vérifier que RLS
# tient vraiment. Cette clé n'est pas secrète (sb_publishable_… ou anon).
SUPABASE_PUBLISHABLE_KEY=
